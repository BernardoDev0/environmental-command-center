datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  OPERATIONS_MANAGER
  USER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  avatarUrl    String? 
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Equipment {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Goal {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contract {
  id        String   @id @default(cuid())
  title     String
  supplierId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Expense {
  id        String   @id @default(cuid())
  label     String
  amount    Decimal  @db.Decimal(18, 2)
  currency  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id        String   @id @default(cuid())
  code      String
  amount    Decimal  @db.Decimal(18, 2)
  currency  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CollaboratorStatus {
  ACTIVE
  INACTIVE
}

model Collaborator {
  id        String             @id @default(cuid())
  name      String
  email     String             @unique
  role      String
  status    CollaboratorStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  objectives Objective[]
}

enum ObjectiveStatus {
  PLANEJADO
  EM_ANDAMENTO
  CONCLUIDO
  ATRASADO
}

enum TaskStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
}

model Objective {
  id             String          @id @default(cuid())
  employeeId     String
  employee       Collaborator    @relation(fields: [employeeId], references: [id])
  title          String
  description    String?
  status         ObjectiveStatus @default(PLANEJADO)
  startDate      DateTime?
  dueDate        DateTime?
  createdByUserId String
  createdBy      User            @relation(fields: [createdByUserId], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tasks          Task[]
  attachments    Attachment[]
}

model Task {
  id          String      @id @default(cuid())
  objectiveId String
  objective   Objective   @relation(fields: [objectiveId], references: [id])
  title       String
  description String?
  status      TaskStatus  @default(PENDENTE)
  dueDate     DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  attachments Attachment[]
}

enum AttachmentRelatedType {
  OBJECTIVE
  TASK
}

model Attachment {
  id          String                 @id @default(cuid())
  relatedType AttachmentRelatedType
  relatedId   String
  fileName    String
  filePath    String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

